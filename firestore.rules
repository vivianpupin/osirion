rules_version = '2';
// Cada pessoa só lê e escreve a própria jornada.
service cloud.firestore {
  match /databases/{database}/documents {
    match /jornadas/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // a inscrição das notificações e os horários de cada pessoa
    match /avisos/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
